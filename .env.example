# Chave do Ollama Cloud — gere em https://ollama.com/settings/keys
# NUNCA commite o valor real; copie este arquivo para .env (coberto pelo .gitignore).
OLLAMA_API_KEY=

# Modelo padrão do assistente do dashboard.
OLLAMA_MODEL=gemma4:31b-cloud

# Host do Ollama. Só sobrescreva se usar um endpoint próprio/embutido.
# OLLAMA_HOST=https://ollama.com
